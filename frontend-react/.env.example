# =============================================================================
# Frontend (Vite/React) – copy to .env and fill values. In production set
# these as environment variables in Vercel (Build / Environment Variables);
# only VITE_* are exposed to the client.
# =============================================================================

# API (required: backend URL + /api)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_WS_URL=ws://127.0.0.1:8000/ws

# Stripe publishable key (use test key in dev)
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# Razorpay (India: UPI, cards, netbanking) – same as backend key ID
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# App environment
VITE_APP_ENV=development

# Optional: Google Analytics, AdSense (optional in dev)
VITE_GA4_ID=G-XXXXXXXXXX
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
